# TrucksLeón Premium — Environment Variables Example
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com
RESEND_API_KEY=

# Where contact form submissions land
CONTACT_TO_EMAIL=info@trucksleon.com

# The "From" address shown in the email.
# IMPORTANT: this domain must be verified in your Resend account.
CONTACT_FROM_EMAIL=no-reply@trucksleon.com

# ── Public site URL ───────────────────────────────────────────────────────────
# Origin this build is served from. Drives canonical URLs, hreflang, Open Graph
# URLs, the sitemap and robots.txt. Defaults to the production domain.
#
#   production      https://trucksleon.com          (default, no need to set)
#   GitHub Pages    https://tscesar.github.io/TrucksLeon
#                   (set automatically by `npm run build:pages` — note it
#                    already includes the /TrucksLeon base path)
#
# NEXT_PUBLIC_SITE_URL=https://trucksleon.com

# ── Analytics (optional) ──────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
