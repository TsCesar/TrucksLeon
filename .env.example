# TrucksLeón International — environment variables
#
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Every value below is a placeholder or a public URL: no secret belongs in
# this file.
#
# Naming rule: anything prefixed NEXT_PUBLIC_ is inlined into the browser
# bundle and is world-readable. Secrets and policy flags must NOT use it.

# ── Public site URL ───────────────────────────────────────────────────────────
# The origin this deployment is served from. Drives canonical URLs, hreflang,
# Open Graph URLs, the sitemap and robots.txt.
#
#   production      https://trucksleon.com                (default if unset)
#   GitHub Pages    https://tscesar.github.io/TrucksLeon  (set automatically by
#                   `npm run build:pages`; already includes the base path)
#
# NEXT_PUBLIC_SITE_URL=https://trucksleon.com

# ── Search engine indexing (server-side, opt-in) ──────────────────────────────
# Indexing is OFF unless this is exactly "true". Anything else — unset, empty,
# "1", "yes" — produces noindex on every page plus an X-Robots-Tag header.
#
# Set it to true ONLY on the deployment serving the real domain, and only once
# the domain, redirects, form, sitemap, canonical and robots have all been
# verified in production. See docs/production-deployment.md.
#
# BUILD-TIME: set it BEFORE `npm run build`. Prerendered metadata and the
# X-Robots-Tag header rule are fixed during the build. A build made with
# ALLOW_INDEXING=false keeps serving noindex even if the variable is changed
# afterwards: change it to true, run a NEW `npm run build`, restart/redeploy that
# build, then verify robots.txt, the robots meta and X-Robots-Tag.
#
# Deliberately not NODE_ENV-based: staging and preview builds are production
# builds too, and every one of them would otherwise compete with trucksleon.com
# for the same content in five languages.
ALLOW_INDEXING=false

# ── Geo-IP language detection (server-side, optional) ─────────────────────────
# Name of the request header carrying the visitor's two-letter country code.
# Used ONLY on "/" to pick a language; see docs/deployment-geoip.md.
#
# Leave it UNSET unless the hosting platform documents such a header AND
# overwrites it on every request. Exactly one header name is read: scanning for
# plausible names would let any client choose its own language by sending one.
#
# Typical values, depending on the host:
#   GEO_COUNTRY_HEADER=cf-ipcountry          (Cloudflare)
#   GEO_COUNTRY_HEADER=x-vercel-ip-country   (Vercel)
#   GEO_COUNTRY_HEADER=x-geoip-country       (various reverse proxies)
#
# Set it BEFORE build/deploy once the final host is known (not decided yet);
# changing it later means rebuilding and redeploying.
#
# Unset, or header absent/malformed -> "/" resolves to /en. The site works
# perfectly without it; geo detection is an enhancement, not a dependency.
# GEO_COUNTRY_HEADER=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Server-side only. Never expose this key, never prefix it NEXT_PUBLIC_.
# Get a key at https://resend.com
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=info@trucksleon.com

# The From address. MUST be on a domain verified in Resend, and must NOT be the
# visitor's own address — sending as the visitor fails SPF/DMARC and lands the
# mail in spam. The visitor's address is set as Reply-To instead, so replying
# from the inbox still reaches them.
# Recommendation (not applied): verify send.trucksleon.com in Resend and use
# no-reply@send.trucksleon.com, isolating transactional mail from the corporate
# mailbox. Do not change this value until that subdomain is verified.
CONTACT_FROM_EMAIL=no-reply@trucksleon.com

# ── Analytics (optional, not currently used) ──────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
