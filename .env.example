# TrucksLeón Premium — Environment Variables Example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# Contact form email endpoint (future phase)
# CONTACT_API_KEY=your_api_key_here

# Email service (e.g. Resend, SendGrid) — future phase
# EMAIL_FROM=noreply@trucksleon.com
# EMAIL_TO=info@trucksleon.com

# Rate limiting — future phase
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# Analytics — future phase
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
